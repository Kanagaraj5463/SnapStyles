# MongoDB Atlas/remote cluster. User profiles and profile images (GridFS) are stored here.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/snapstyles?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
API_PORT=3001
CLIENT_ORIGIN=http://localhost:8080
# Recommended in production for reliable WebRTC across restrictive networks.
TURN_URL=turn:turn.example.com:3478
TURN_USERNAME=replace-with-turn-username
TURN_CREDENTIAL=replace-with-turn-credential
# YouTube Data API v3 key used server-side for creator music search.
YOUTUBE_API_KEY=replace-with-youtube-data-api-key
